def generate_auto_questions(count=30):
    questions = []
    mc_count = int(count * 0.7)
    tf_count = count - mc_count

    mc_selected = random.sample(QUESTION_BANK_MC, min(mc_count, len(QUESTION_BANK_MC)))
    for q_txt, opts, c_idx in mc_selected:
        questions.append({
            "type": "mc",
            "question": q_txt,
            "options": opts,
            "correct_option_index": c_idx
        })

    tf_selected = random.sample(QUESTION_BANK_TF, min(tf_count, len(QUESTION_BANK_TF)))
    for q_txt, opts, c_idx in tf_selected:
        questions.append({
            "type": "tf",
            "question": q_txt,
            "options": opts,
            "correct_option_index": c_idx
        })

    random.shuffle(questions)
    return questions[:count]

def initialize_storage():
    os.makedirs(DATA_DIR, exist_ok=True)
    os.makedirs(QUESTIONS_DIR, exist_ok=True)

    files = [
        (STUDENTS_CSV, STUDENT_FIELDS),
        (RETIRED_CSV, ["student_id", "date_retired"]),
        (QUIZZES_CSV, QUIZ_FIELDS),
        (SESSIONS_CSV, SESSION_FIELDS),
        (CONFLICTS_CSV, CONFLICT_FIELDS)
    ]

    for path, headers in files:
        if not os.path.exists(path):
            with open(path, "w", newline="", encoding="utf-8") as f:
                csv.DictWriter(f, fieldnames=headers).writeheader()

    if not os.path.exists(AUTH_CSV):
        with open(AUTH_CSV, "w", newline="", encoding="utf-8") as f:
            writer = csv.DictWriter(f, fieldnames=["password_hash"])
            writer.writeheader()
            writer.writerow({"password_hash": hash_pass("jabaiskript")})

    quizzes = read_data(QUIZZES_CSV)
    if not quizzes:
        spaced_date = get_spaced_now()
        q_rows = [
            {"quiz_id": "QUIZ_001", "title": "Comprehensive CS & Science Assessment", "subject": "General", "total_questions": "30", "duration_minutes": "30", "date_published": spaced_date},
            {"quiz_id": "QUIZ_002", "title": "Midterm Exam - STEM Fundamentals", "subject": "STEM", "total_questions": "20", "duration_minutes": "20", "date_published": spaced_date}
        ]
        for q in q_rows:
            qs = generate_auto_questions(int(q["total_questions"]))
            q_path = os.path.join(QUESTIONS_DIR, f"{q['quiz_id']}.json")
            with open(q_path, "w", encoding="utf-8") as f:
                json.dump(qs, f, indent=2)

        write_data(QUIZZES_CSV, q_rows, QUIZ_FIELDS)

def read_data(path: str) -> list:
    if not os.path.exists(path):
        return []
    with open(path, "r", encoding="utf-8") as f:
        return list(csv.DictReader(f))

def write_data(path: str, rows: list, headers: list):
    with open(path, "w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=headers)
        writer.writeheader()
        writer.writerows(rows)

def load_quiz_questions(quiz_id: str) -> list:
    path = os.path.join(QUESTIONS_DIR, f"{quiz_id}.json")
    if not os.path.exists(path):
        return []
    with open(path, "r", encoding="utf-8") as f:
        return json.load(f)

def save_quiz_questions(quiz_id: str, questions: list):
    path = os.path.join(QUESTIONS_DIR, f"{quiz_id}.json")
    with open(path, "w", encoding="utf-8") as f:
        json.dump(questions, f, indent=2)

def table_cell(text: str) -> QTableWidgetItem:
    item = QTableWidgetItem(text)
    item.setFlags(Qt.ItemFlag.ItemIsSelectable | Qt.ItemFlag.ItemIsEnabled)
    return item


