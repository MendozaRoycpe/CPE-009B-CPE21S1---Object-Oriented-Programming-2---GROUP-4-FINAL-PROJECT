            return
        self.current_mode = "tablet"
        self.lbl_device_badge.setText("📲 Tablet View Mode")
        self.lbl_responsive_prompt.setText(
            "<b>Tablet Prompt:</b> Tap to select a quiz from the table. "
            "Ensure device orientation remains locked before entering fullscreen mode."
        )

    def apply_pc_mode(self):
        if self.current_mode == "pc":
            return
        self.current_mode = "pc"
        self.lbl_device_badge.setText("🖥️ Desktop PC View Mode")
        self.lbl_responsive_prompt.setText(
            "<b>Desktop Prompt:</b> Select a quiz using your mouse pointer. "
            "Click <b>Launch Selected Quiz</b> to proceed to the fullscreen confirmation screen."
        )

    def logout(self):
        self.close()
        if self.on_logout:
            self.on_logout()

    def load_quizzes(self):
        self.table.setRowCount(0)
        sessions = read_data(SESSIONS_CSV)
        sid = self.student_data.get("student_id", "")

        for q in read_data(QUIZZES_CSV):
            qid = q.get("quiz_id")
            total_q = int(q.get("total_questions", "0") or 0)
            att = [s for s in sessions if s.get("student_id") == sid and s.get("quiz_id") == qid]

            if att:
                sc = int(att[-1].get("score", "0") or 0)
                score_str = f"{sc} / {total_q}"
                rem = att[-1].get("remarks") or calculate_remarks(sc, total_q)
                status_str = f"Completed ({rem})"
            else:
                score_str = "- / -"
                status_str = "Available"

            r = self.table.rowCount()
            self.table.insertRow(r)
            item = table_cell(q.get("title", ""))
            item.setData(Qt.ItemDataRole.UserRole, qid)
            self.table.setItem(r, 0, item)
            self.table.setItem(r, 1, table_cell(f"{total_q} Questions"))
            self.table.setItem(r, 2, table_cell(f"{q.get('duration_minutes', '10')} Mins"))
            self.table.setItem(r, 3, table_cell(q.get("date_published", "N/A")))
            self.table.setItem(r, 4, table_cell(score_str))
            
            st_item = table_cell(status_str)
            if "Completed" in status_str:
                st_item.setForeground(QColor("#10b981"))
            else:
                st_item.setForeground(QColor("#818cf8"))
            self.table.setItem(r, 5, st_item)

    def start_quiz(self):
        r = self.table.currentRow()
        if r < 0:
            QMessageBox.information(self, "Selection Required", "Please select a quiz from the table first.")
            return

        item = self.table.item(r, 0)
        if item is not None:
            qid = item.data(Qt.ItemDataRole.UserRole)
            qs = load_quiz_questions(qid)
            if not qs:
                QMessageBox.warning(self, "Empty Quiz", "This quiz does not contain any questions yet.")
                return

            q_list = read_data(QUIZZES_CSV)
            qz = next((q for q in q_list if q.get("quiz_id") == qid), {})
            title = qz.get("title", "Quiz")
            dur = qz.get("duration_minutes", "10")

            prompt = FullscreenPromptDialog(quiz_title=title, duration=dur, total_q=str(len(qs)), parent=self)
            if prompt.exec() == QDialog.DialogCode.Accepted:
                self.runner = QuizRunner(self.student_data, qid, on_finish=self.load_quizzes)
                self.runner.showFullScreen()


# ==========================================
# PROCTORED FULLSCREEN QUIZ RUNNER
# ==========================================
class QuizRunner(QWidget):
    def __init__(self, student_data: dict, quiz_id: str, on_finish=None, parent=None):
        super().__init__(parent)
        self.setStyleSheet(APP_STYLE)
        self.student_data = student_data
        self.quiz_id = quiz_id
        self.on_finish = on_finish
        self.questions = load_quiz_questions(quiz_id)
        self.index = 0
        self.answers = {}
        self.tab_switches = 0
        self.is_submitted = False
        self.is_fully_initialized = False

        q_list = read_data(QUIZZES_CSV)
        qz = next((q for q in q_list if q.get("quiz_id") == quiz_id), {})
        self.title = qz.get("title", "Quiz")
        self.duration_mins = int(qz.get("duration_minutes", 10))
        self.time_left = self.duration_mins * 60
        self.end_time_str = (datetime.now() + timedelta(minutes=self.duration_mins)).strftime("%I:%M %p")

        self.num_buttons = []
        self.build_ui()
        self.start_timer()
        self.render_q()

        QTimer.singleShot(1500, self.mark_initialized)

    def mark_initialized(self):
        self.is_fully_initialized = True

    def build_ui(self):
        self.setWindowTitle(f"Quiz Portal - {self.title}")
        apply_icon(self)

        main_layout = QVBoxLayout(self)
        main_layout.setContentsMargins(30, 20, 30, 20)
        main_layout.setSpacing(12)

        top = QHBoxLayout()
        self.lbl_title = QLabel(f"<b style='font-size:20px; color:#818cf8;'>📝 {self.title}</b>")
        
        self.lbl_duration_info = QLabel(f"⏱️ {self.duration_mins} Mins Allocated (Ends at {self.end_time_str})")
        self.lbl_duration_info.setStyleSheet("font-size: 13px; font-weight: bold; color: #a5b4fc; background: #151c2c; padding: 6px 12px; border-radius: 8px;")

        self.lbl_timer = QLabel("⏱️ 00:00")
        self.lbl_timer.setStyleSheet("font-size: 18px; font-weight: bold; color: #818cf8; background: #151c2c; padding: 6px 16px; border-radius: 8px; border: 1px solid #334155;")
        
        top.addWidget(self.lbl_title)
        top.addStretch()
        top.addWidget(self.lbl_duration_info)
        top.addWidget(self.lbl_timer)
        main_layout.addLayout(top)

        nav_scroll = QScrollArea()
        nav_scroll.setFixedHeight(54)
        nav_scroll.setWidgetResizable(True)
        nav_scroll.setStyleSheet("QScrollArea { border: 1px solid #222d42; border-radius: 8px; background: #0f172a; }")

        num_container = QWidget()
        self.num_layout = QHBoxLayout(num_container)
        self.num_layout.setContentsMargins(8, 6, 8, 6)
        self.num_layout.setSpacing(6)

        for i in range(len(self.questions)):
            btn = QPushButton(f"{i + 1}")
            btn.setFixedWidth(38)
            btn.setObjectName("BtnNumUnanswered")
            btn.clicked.connect(lambda _, idx=i: self.jump_to_q(idx))
            self.num_buttons.append(btn)
            self.num_layout.addWidget(btn)

        self.num_layout.addStretch()
        nav_scroll.setWidget(num_container)
        main_layout.addWidget(nav_scroll)

        self.warn_card = QFrame()
        self.warn_card.setObjectName("WarningCardClean")
        wc_layout = QHBoxLayout(self.warn_card)
        wc_layout.setContentsMargins(16, 8, 16, 8)
        
        self.lbl_warning = QLabel("🛡️ Anti-Cheat Active — Tab switching or focus shifts are strictly recorded.")
        self.lbl_warning.setStyleSheet("color: #10b981; font-weight: bold;")
        self.lbl_switches = QLabel("Focus Loss: 0")
        self.lbl_switches.setStyleSheet("color: #ffffff; font-weight: bold; background: #0f172a; padding: 4px 10px; border-radius: 6px;")
        
        wc_layout.addWidget(self.lbl_warning)
        wc_layout.addStretch()
        wc_layout.addWidget(self.lbl_switches)
        main_layout.addWidget(self.warn_card)

        self.progress = QProgressBar()
        main_layout.addWidget(self.progress)

        self.card = QFrame()
        self.card.setObjectName("Panel")
        c_layout = QVBoxLayout(self.card)
        c_layout.setContentsMargins(24, 20, 24, 20)

        self.lbl_q_num = QLabel("Question 1")
        self.lbl_q_num.setStyleSheet("color: #6366f1; font-weight: bold; font-size: 15px;")
        
        self.lbl_q_txt = QLabel("Question text...")
        self.lbl_q_txt.setWordWrap(True)
        self.lbl_q_txt.setStyleSheet("font-size: 17px; font-weight: 600; margin-top: 8px; margin-bottom: 12px;")

        c_layout.addWidget(self.lbl_q_num)
        c_layout.addWidget(self.lbl_q_txt)

        self.options_stack = QStackedWidget()

        self.radio_widget = QWidget()
        rw_layout = QVBoxLayout(self.radio_widget)
        rw_layout.setContentsMargins(0, 0, 0, 0)
        rw_layout.setSpacing(10)
        
        self.btn_group = QButtonGroup(self)
        self.radios = []
        for i in range(4):
            r = QRadioButton(f"Option {i+1}")
            r.setStyleSheet("font-size: 14px;")
            self.btn_group.addButton(r, i)
            self.radios.append(r)
            rw_layout.addWidget(r)
        
        self.btn_group.idClicked.connect(self.option_selected)
        self.options_stack.addWidget(self.radio_widget)

        c_layout.addWidget(self.options_stack)
        main_layout.addWidget(self.card)

        nav = QHBoxLayout()
        self.btn_prev = QPushButton("◄ Previous")
        self.btn_prev.setObjectName("BtnSecondary")
        self.btn_prev.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Fixed)
        self.btn_prev.clicked.connect(self.prev_q)

        self.btn_next = QPushButton("Next ►")
        self.btn_next.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Fixed)
        self.btn_next.clicked.connect(self.next_q)

        self.btn_submit = QPushButton("Submit Final Answers")
        self.btn_submit.setObjectName("BtnDanger")
        self.btn_submit.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Fixed)
        self.btn_submit.clicked.connect(self.confirm_submit)

        nav.addWidget(self.btn_prev)
        nav.addWidget(self.btn_next)
        nav.addWidget(self.btn_submit)
        main_layout.addLayout(nav)

    def changeEvent(self, a0: QEvent | None) -> None:
        if a0 is not None and a0.type() == QEvent.Type.ActivationChange:
            if self.is_fully_initialized and not self.isActiveWindow() and not self.is_submitted and self.isVisible():
                self.tab_switches += 1
                self.lbl_switches.setText(f"Focus Loss: {self.tab_switches}")
                self.lbl_warning.setText("⚠️ ALERT: Tab switch or window focus loss incident recorded!")
                self.lbl_warning.setStyleSheet("color: #ef4444; font-weight: bold;")
                self.warn_card.setObjectName("WarningCardWarn")
                self.warn_card.setStyle(self.warn_card.style())
                self.log_anti_cheat_incident()
        super().changeEvent(a0)

    def log_anti_cheat_incident(self):
        conflicts = read_data(CONFLICTS_CSV)
        conf_id = f"CONF_{len(conflicts) + 1:04d}"
        sid = self.student_data.get("student_id", "Unknown")
        now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        
        conflicts.append({
            "conflict_id": conf_id,
            "student_id": sid,
            "issue_type": "Focus Loss / App Shift",
            "description": f"Window lost focus during quiz '{self.quiz_id}'. Count: {self.tab_switches}",
            "timestamp": now,
            "status": "Flagged"
        })
        write_data(CONFLICTS_CSV, conflicts, CONFLICT_FIELDS)

    def start_timer(self):
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.update_timer)
        self.timer.start(1000)
        self.update_timer_display()

    def update_timer(self):
        if self.time_left > 0:
            self.time_left -= 1
            self.update_timer_display()
        else:
            self.timer.stop()
            unanswered = [i + 1 for i in range(len(self.questions)) if i not in self.answers]
            if unanswered:
                QMessageBox.warning(
                    self, "Time Limit Reached", 
                    f"Time limit expired! However, you still have unanswered questions: {unanswered[:5]}...\n\n"
                    "Please quickly pick answers or complete unanswered items to submit!"
                )
            else:
                self.submit_quiz()

    def update_timer_display(self):
        m, s = divmod(self.time_left, 60)
        self.lbl_timer.setText(f"⏱️ {m:02d}:{s:02d}")
        if self.time_left < 60:
            self.lbl_timer.setStyleSheet("font-size: 18px; font-weight: bold; color: #ef4444; background: #151c2c; padding: 6px 16px; border-radius: 8px; border: 1px solid #ef4444;")

    def render_q(self):
        total = len(self.questions)
        if total == 0:
            return

        self.progress.setValue(int(((self.index + 1) / total) * 100))
        self.lbl_q_num.setText(f"Question {self.index + 1} of {total}")
        
        q_data = self.questions[self.index]
        self.lbl_q_txt.setText(q_data.get("question", ""))

        self.options_stack.setCurrentIndex(0)
        opts = q_data.get("options", [])
        
        self.btn_group.setExclusive(False)
        for i, r in enumerate(self.radios):
            if i < len(opts):
                r.setText(opts[i])
                r.show()
                r.setChecked(False)
            else:
                r.hide()
        self.btn_group.setExclusive(True)

        saved_ans = self.answers.get(self.index)
        if saved_ans is not None and isinstance(saved_ans, int) and saved_ans < len(opts):
            self.radios[saved_ans].setChecked(True)

        self.btn_prev.setEnabled(self.index > 0)
        self.btn_next.setEnabled(self.index < total - 1)
        self.update_num_buttons()

    def update_num_buttons(self):
        for i, btn in enumerate(self.num_buttons):
            if i == self.index:
                btn.setObjectName("BtnNumCurrent")
            elif i in self.answers:
                btn.setObjectName("BtnNumAnswered")
            else:
                btn.setObjectName("BtnNumUnanswered")
            btn.setStyle(btn.style())

    def jump_to_q(self, idx: int):
        if 0 <= idx < len(self.questions):
            self.index = idx
            self.render_q()

    def option_selected(self, btn_id):
        self.answers[self.index] = btn_id
        self.update_num_buttons()

    def prev_q(self):
        if self.index > 0:
            self.index -= 1
            self.render_q()

    def next_q(self):
        if self.index < len(self.questions) - 1:
            self.index += 1
            self.render_q()

    def confirm_submit(self):
        unanswered = [i + 1 for i in range(len(self.questions)) if i not in self.answers]
        if unanswered:
            un_str = ", ".join(map(str, unanswered[:10]))
            if len(unanswered) > 10:
                un_str += f" (+{len(unanswered) - 10} more)"
            QMessageBox.warning(
                self, "Unanswered Questions Remaining", 
                f"You cannot submit yet!\n\nPlease answer all items before submitting.\n\nMissing Questions: #{un_str}"
            )
            return

        res = QMessageBox.question(
            self, "Confirm Submission", 
            "Are you sure you want to finish and submit your quiz?",
            QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No
        )
        if res == QMessageBox.StandardButton.Yes:
            self.submit_quiz()

    def submit_quiz(self):
        self.is_submitted = True
        if hasattr(self, "timer"):
            self.timer.stop()

        score = 0
        total_q = len(self.questions)
        for i, q in enumerate(self.questions):
            user_ans = self.answers.get(i)
            correct_idx = q.get("correct_option_index", 0)
            if user_ans == correct_idx:
                score += 1

        remarks = calculate_remarks(score, total_q)
        sessions = read_data(SESSIONS_CSV)
        sess_id = f"SESS_{len(sessions) + 1:04d}"
        now_spaced = get_spaced_now()
        sid = self.student_data.get("student_id", "")

        sessions.append({
            "session_id": sess_id,
            "student_id": sid,
            "quiz_id": self.quiz_id,
            "score": str(score),
            "date_taken": now_spaced,
            "tab_switches": str(self.tab_switches),
            "remarks": remarks
        })
        write_data(SESSIONS_CSV, sessions, SESSION_FIELDS)

        QMessageBox.information(
            self, "Submission Complete", 
            f"Quiz submitted successfully!\n\nFinal Score: {score} / {total_q}\nRemarks: {remarks}\nFocus Shifts Detected: {self.tab_switches}"
        )

        self.showNormal()
        self.close()
        if self.on_finish:
            self.on_finish()


# ==========================================
# APPLICATION CONTROLLER
# ==========================================
class ApplicationController:
    def __init__(self):
        self.login_dlg = None
        self.main_window = None

    def start(self):
        initialize_storage()
        self.show_login()

    def show_login(self):
        self.login_dlg = LoginWindow()
        if self.login_dlg.exec() == QDialog.DialogCode.Accepted:
            role = self.login_dlg.user_role
            if role == "professor":
                self.main_window = ProfessorDashboard(on_logout=self.show_login)
                self.main_window.show()
            elif role == "student":
                self.main_window = StudentDashboard(
                    student_data=self.login_dlg.student_data, 
                    on_logout=self.show_login
                )
                self.main_window.show()

def main():
    app = QApplication(sys.argv)
    controller = ApplicationController()
    controller.start()
    sys.exit(app.exec())

if __name__ == "__main__":
    main()

