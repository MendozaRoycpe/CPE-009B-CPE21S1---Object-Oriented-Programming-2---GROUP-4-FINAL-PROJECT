        self.txt_prof_pass.setEchoMode(QLineEdit.EchoMode.Password)
        # BIND ENTER KEY PRESS DIRECTLY TO LOGIN ACTION
        self.txt_prof_pass.returnPressed.connect(self.login)
        pr_layout.addWidget(self.txt_prof_pass)

        p_layout.addWidget(self.prof_box)

        self.btn_login = QPushButton("Authenticate Session")
        self.btn_login.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Fixed)
