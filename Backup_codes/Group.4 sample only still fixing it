class QuizQuestionsManager(QDialog):
    def __init__(self, quiz_id, quiz_title, questions=None, is_publish_mode=False, parent=None):
        super().__init__(parent)
        self.setStyleSheet(APP_STYLE)
        self.quiz_id = quiz_id
        self.quiz_title = quiz_title
        self.is_publish_mode = is_publish_mode
        self.setWindowTitle(f"Publish Preview - Edit Questions for '{quiz_title}'" if is_publish_mode else f"Quiz Portal - {quiz_title}")
        apply_icon(self)
        self.resize(780, 520)
        self.questions = questions if questions is not None else load_quiz_questions(self.quiz_id)
        self.build_ui()

    def build_ui(self):
        layout = QVBoxLayout(self)

        if self.is_publish_mode:
            info = QLabel("<b>Editable Question Set Before Publishing:</b> Review or edit generated questions below before committing.")
            info.setStyleSheet("color: #818cf8; margin-bottom: 6px;")
            layout.addWidget(info)

        self.table = QTableWidget(0, 3)
        self.table.verticalHeader().hide()
        self.table.setHorizontalHeaderLabels(["#", "Question Prompt", "Correct Answer"])
        header = self.table.horizontalHeader()
        if header is not None:
            header.setSectionResizeMode(1, QHeaderView.ResizeMode.Stretch)
        layout.addWidget(self.table)

        btns = QHBoxLayout()
        btn_add = QPushButton("+ Add Question")
        btn_add.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Fixed)
        btn_add.clicked.connect(self.add_q)

        btn_edit = QPushButton("Edit")
        btn_edit.setObjectName("BtnSecondary")
        btn_edit.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Fixed)
        btn_edit.clicked.connect(self.edit_q)

        btn_del = QPushButton("Delete")
        btn_del.setObjectName("BtnDanger")
        btn_del.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Fixed)
        btn_del.clicked.connect(self.del_q)

        btns.addWidget(btn_add)
        btns.addWidget(btn_edit)
        btns.addWidget(btn_del)
        layout.addLayout(btns)

        if self.is_publish_mode:
            btn_confirm_pub = QPushButton("✅ Publish Quiz to Database")
            btn_confirm_pub.setStyleSheet("background-color: #10b981; font-size: 14px; padding: 12px;")
            btn_confirm_pub.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Fixed)
            btn_confirm_pub.clicked.connect(self.accept)
            layout.addWidget(btn_confirm_pub)

        self.refresh()

    def refresh(self):
        self.table.setRowCount(0)
        for i, q in enumerate(self.questions):
            row = self.table.rowCount()
            self.table.insertRow(row)
            self.table.setItem(row, 0, table_cell(str(i + 1)))
            self.table.setItem(row, 1, table_cell(q.get("question", "")))
            
            c_idx = q.get("correct_option_index", 0)
            opts = q.get("options", [])
            txt = opts[c_idx] if c_idx < len(opts) else "N/A"
            self.table.setItem(row, 2, table_cell(txt))

    def add_q(self):
        dlg = QuestionEditorDialog(parent=self)
        if dlg.exec() == QDialog.DialogCode.Accepted:
            self.questions.append(dlg.question_data)
            if not self.is_publish_mode:
                save_quiz_questions(self.quiz_id, self.questions)
                self.sync_count()
            self.refresh()

    def edit_q(self):
        row = self.table.currentRow()
        if row < 0:
            return
        dlg = QuestionEditorDialog(question_data=self.questions[row], parent=self)
        if dlg.exec() == QDialog.DialogCode.Accepted:
            self.questions[row] = dlg.question_data
            if not self.is_publish_mode:
                save_quiz_questions(self.quiz_id, self.questions)
            self.refresh()

    def del_q(self):
        row = self.table.currentRow()
        if row < 0:
            return
        self.questions.pop(row)
        if not self.is_publish_mode:
            save_quiz_questions(self.quiz_id, self.questions)
            self.sync_count()
        self.refresh()

    def sync_count(self):
        quizzes = read_data(QUIZZES_CSV)
        for q in quizzes:
            if q.get("quiz_id") == self.quiz_id:
                q["total_questions"] = str(len(self.questions))
                break
        write_data(QUIZZES_CSV, quizzes, QUIZ_FIELDS)


