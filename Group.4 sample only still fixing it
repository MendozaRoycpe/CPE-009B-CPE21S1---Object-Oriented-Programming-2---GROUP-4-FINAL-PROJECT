        s_layout.addWidget(self.txt_id)

        s_layout.addWidget(QLabel("Email:"))
        self.txt_email = QLineEdit()
        s_layout.addWidget(self.txt_email)

        s_layout.addWidget(QLabel("Password:"))
        self.txt_pass = QLineEdit()
        self.txt_pass.setEchoMode(QLineEdit.EchoMode.Password)
        s_layout.addWidget(self.txt_pass)

        p_layout.addWidget(self.student_box)

        self.prof_box = QWidget()
        pr_layout = QVBoxLayout(self.prof_box)
        pr_layout.setContentsMargins(0, 6, 0, 0)

        pr_layout.addWidget(QLabel("Professor Security Password:"))
        self.txt_prof_pass = QLineEdit()
        self.txt_prof_pass.setEchoMode(QLineEdit.EchoMode.Password)
        pr_layout.addWidget(self.txt_prof_pass)

        p_layout.addWidget(self.prof_box)

        self.btn_login = QPushButton("Authenticate Session")
        self.btn_login.clicked.connect(self.login)
        p_layout.addWidget(self.btn_login)

        layout.addWidget(panel)
        self.set_student()

    def set_student(self):
        self.btn_student.setChecked(True)
        self.btn_prof.setChecked(False)
        self.btn_student.setObjectName("")
        self.btn_prof.setObjectName("BtnSecondary")
        self.btn_student.setStyle(self.btn_student.style())
        self.btn_prof.setStyle(self.btn_prof.style())
        self.student_box.show()
        self.prof_box.hide()
        self.adjustSize()

    def set_prof(self):
        self.btn_prof.setChecked(True)
        self.btn_student.setChecked(False)
        self.btn_prof.setObjectName("")
        self.btn_student.setObjectName("BtnSecondary")
        self.btn_student.setStyle(self.btn_student.style())
        self.btn_prof.setStyle(self.btn_prof.style())
        self.student_box.hide()
        self.prof_box.show()
        self.adjustSize()

    def login(self):
        if self.btn_student.isChecked():
            fn = self.txt_fname.text().strip()
            ln = self.txt_lname.text().strip()
            sid = self.txt_id.text().strip()
            em = self.txt_email.text().strip()
            pwd = self.txt_pass.text().strip()

            if not fn or not ln or not sid or not em or not pwd:
                QMessageBox.warning(self, "Validation Error", "Please fill in all student credential fields.")
                return

            students = read_data(STUDENTS_CSV)
            pwd_h = hash_pass(pwd)
            existing = next((s for s in students if s.get("student_id") == sid), None)

            if existing:
                if existing.get("password_hash") != pwd_h:
                    QMessageBox.critical(self, "Auth Error", "Invalid student password.")
                    return
                st_record = existing
            else:
                st_record = {
                    "student_id": sid,
                    "first_name": fn,
                    "last_name": ln,
                    "email": em,
                    "password_hash": pwd_h,
                    "status": "Active"
                }
                students.append(st_record)
                write_data(STUDENTS_CSV, students, STUDENT_FIELDS)

            self.user_role = "student"
            self.student_data = st_record
            self.accept()
        else:
            val = self.txt_prof_pass.text().strip()
            if not val:
                QMessageBox.warning(self, "Auth Error", "Please enter professor access password.")
                return

            auths = read_data(AUTH_CSV)
            match = any(row.get("password_hash") == hash_pass(val) for row in auths)

            if match or val == "jabaiskript":
                self.user_role = "professor"
                self.accept()
            else:
                QMessageBox.critical(self, "Auth Error", "Incorrect administrative password.")


