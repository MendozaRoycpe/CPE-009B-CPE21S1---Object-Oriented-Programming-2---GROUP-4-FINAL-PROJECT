    def set_student(self):
        self.btn_student.setChecked(True)
        self.btn_prof.setChecked(False)
        self.btn_student.setObjectName("")
        self.btn_prof.setObjectName("BtnSecondary")
        self.btn_student.setStyle(self.btn_student.style())
        self.btn_prof.setStyle(self.btn_prof.style())
        self.student_box.show()
        self.prof_box.hide()
        self.adjustSize()

    def set_prof(self):
        self.btn_prof.setChecked(True)
        self.btn_student.setChecked(False)
        self.btn_prof.setObjectName("")
        self.btn_student.setObjectName("BtnSecondary")
        self.btn_student.setStyle(self.btn_student.style())
        self.btn_prof.setStyle(self.btn_prof.style())
        self.student_box.hide()
        self.prof_box.show()
        self.adjustSize()

    def login(self):
        if self.btn_student.isChecked():
            fn = self.txt_fname.text().strip()
            ln = self.txt_lname.text().strip()
            sid = self.txt_id.text().strip()
            em = self.txt_email.text().strip()
            pwd = self.txt_pass.text().strip()

            if not fn or not ln or not sid or not em or not pwd:
                QMessageBox.warning(self, "Validation Error", "Please complete all student credentials.")
                return

            students = read_data(STUDENTS_CSV)
            pwd_h = hash_pass(pwd)
            existing = next((s for s in students if s.get("student_id") == sid), None)

            if existing:
                if existing.get("password_hash") != pwd_h:
                    QMessageBox.critical(self, "Auth Failure", "Invalid password provided.")
                    return
                if existing.get("first_name", "").lower() != fn.lower() or existing.get("last_name", "").lower() != ln.lower():
                    QMessageBox.warning(self, "Auth Failure", "Name mismatch for registered ID.")
                    return
                st_record = existing
            else:
                st_record = {
                    "student_id": sid,
                    "first_name": fn,
                    "last_name": ln,
                    "email": em,
                    "password_hash": pwd_h,
                    "status": "Active"
                }
                students.append(st_record)
                write_data(STUDENTS_CSV, students, STUDENT_FIELDS)

            self.user_role = "student"
            self.student_data = st_record
            self.accept()
        else:
            val = self.txt_prof_pass.text().strip()
            if not val:
                QMessageBox.warning(self, "Auth Failure", "Please enter professor password.")
                return

            auths = read_data(AUTH_CSV)
            match = any(row.get("password_hash") == hash_pass(val) for row in auths)

            if match or val == "jabaiskript":
                self.user_role = "professor"
                self.accept()
            else:
                QMessageBox.critical(self, "Auth Failure", "Incorrect administrative password.")


