class GradebookDialog(QDialog):
    def __init__(self, student_id=None, parent=None):
        super().__init__(parent)
        self.setStyleSheet(APP_STYLE)
        self.setWindowTitle("Quiz Portal - Gradebook & Anti-Cheat Audit")
        apply_icon(self)
        self.resize(860, 480)
        self.student_id = student_id
        self.build_ui()

    def build_ui(self):
        layout = QVBoxLayout(self)

        top_panel = QFrame()
        top_panel.setObjectName("Panel")
        tp_layout = QHBoxLayout(top_panel)

        tp_layout.addWidget(QLabel("Filter by Last Name:"))
        self.cmb_filter = QComboBox()
        self.cmb_filter.currentIndexChanged.connect(self.load_results)
        tp_layout.addWidget(self.cmb_filter)

        layout.addWidget(top_panel)

        self.table = QTableWidget(0, 6)
        self.table.setHorizontalHeaderLabels(["ID", "Student Name", "Quiz Title", "Score", "Tab Switches", "Proctor Status"])
        header = self.table.horizontalHeader()
        if header is not None:
            header.setSectionResizeMode(1, QHeaderView.ResizeMode.Stretch)
            header.setSectionResizeMode(2, QHeaderView.ResizeMode.Stretch)

        layout.addWidget(self.table)

        btn_close = QPushButton("Close Gradebook")
        btn_close.setObjectName("BtnSecondary")
        btn_close.clicked.connect(self.accept)
        layout.addWidget(btn_close)

        self.fill_names()
        self.load_results()

    def fill_names(self):
        students = read_data(STUDENTS_CSV)
        names = sorted(list({s.get("last_name", "").strip() for s in students if s.get("last_name")}))
        
        self.cmb_filter.blockSignals(True)
        self.cmb_filter.clear()
        self.cmb_filter.addItem("All Last Names")
        for n in names:
            self.cmb_filter.addItem(n)
        self.cmb_filter.blockSignals(False)

    def load_results(self):
        self.table.setRowCount(0)
        students = read_data(STUDENTS_CSV)
        quizzes = {q.get("quiz_id"): q for q in read_data(QUIZZES_CSV)}
        sessions = read_data(SESSIONS_CSV)

        selected_ln = self.cmb_filter.currentText()

        if self.student_id:
            sessions = [s for s in sessions if s.get("student_id") == self.student_id]

        for sess in sessions:
            sid = sess.get("student_id", "")
            qid = sess.get("quiz_id", "")
            
            st = next((s for s in students if s.get("student_id") == sid), {})
            st_ln = st.get("last_name", "").strip()

            if selected_ln != "All Last Names" and st_ln.lower() != selected_ln.lower():
                continue

            st_name = f"{st.get('first_name', '')} {st_ln}".strip() or "Unknown"
            qz = quizzes.get(qid, {})
            title = qz.get("title", qid)
            total = qz.get("total_questions", "?")
            score_str = f"{sess.get('score', '0')} / {total}"
            
            switches = int(sess.get("tab_switches", "0") or 0)

            if switches > 2:
                flag_text = f"FLAGGED ({switches} Focus Shifts)"
                color = "#ef4444"
            elif switches > 0:
                flag_text = f"Minor Focus Loss ({switches})"
                color = "#f59e0b"
            else:
                flag_text = "Clean Session"
                color = "#10b981"

            row = self.table.rowCount()
            self.table.insertRow(row)
            self.table.setItem(row, 0, table_cell(sid))
            self.table.setItem(row, 1, table_cell(st_name))
            self.table.setItem(row, 2, table_cell(title))
