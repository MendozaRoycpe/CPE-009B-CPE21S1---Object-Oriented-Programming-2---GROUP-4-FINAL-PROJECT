        self.card = QFrame()
        self.card.setObjectName("Panel")
        c_layout = QVBoxLayout(self.card)
        c_layout.setContentsMargins(28, 28, 28, 28)

        self.lbl_q_num = QLabel("Question 1")
        self.lbl_q_num.setStyleSheet("color: #6366f1; font-weight: bold; font-size: 15px;")
        
        self.lbl_q_txt = QLabel("Question text...")
        self.lbl_q_txt.setWordWrap(True)
        self.lbl_q_txt.setStyleSheet("font-size: 18px; font-weight: 600; margin-top: 10px; margin-bottom: 16px;")

        c_layout.addWidget(self.lbl_q_num)
        c_layout.addWidget(self.lbl_q_txt)

        self.options_stack = QStackedWidget()

        # Page 0: Multiple Choice / True-False Radios
        self.radio_widget = QWidget()
        rw_layout = QVBoxLayout(self.radio_widget)
        rw_layout.setContentsMargins(0, 0, 0, 0)
        rw_layout.setSpacing(10)
        
        self.btn_group = QButtonGroup(self)
        self.radios = []
        for i in range(4):
            r = QRadioButton(f"Option {i+1}")
            r.setStyleSheet("font-size: 14px;")
            self.btn_group.addButton(r, i)
            self.radios.append(r)
            rw_layout.addWidget(r)
        
        self.btn_group.idClicked.connect(self.option_selected)
        self.options_stack.addWidget(self.radio_widget)

        c_layout.addWidget(self.options_stack)
        main_layout.addWidget(self.card)

        # Navigation Bar
        nav = QHBoxLayout()
        self.btn_prev = QPushButton("◄ Previous")
        self.btn_prev.setObjectName("BtnSecondary")
        self.btn_prev.clicked.connect(self.prev_q)

        self.btn_next = QPushButton("Next ►")
        self.btn_next.clicked.connect(self.next_q)

        self.btn_submit = QPushButton("Submit Final Answers")
        self.btn_submit.setObjectName("BtnDanger")
        self.btn_submit.clicked.connect(self.confirm_submit)

        nav.addWidget(self.btn_prev)
        nav.addWidget(self.btn_next)
        nav.addStretch()
        nav.addWidget(self.btn_submit)
        main_layout.addLayout(nav)

    def eventFilter(self, obj, event):
        if obj == self and not self.is_submitted and self.isVisible():
            if event.type() in [QEvent.Type.WindowDeactivate, QEvent.Type.Hide]:
                self.tab_switches += 1
                self.lbl_switches.setText(f"Focus Loss: {self.tab_switches}")
                self.lbl_warning.setText("⚠️ ALERT: Tab switch or focus loss incident recorded!")
                self.lbl_warning.setStyleSheet("color: #ef4444; font-weight: bold;")
                self.warn_card.setObjectName("WarningCardWarn")
                self.warn_card.setStyle(self.warn_card.style())
                
                self.log_anti_cheat_incident()
        return super().eventFilter(obj, event)

    def log_anti_cheat_incident(self):
        conflicts = read_data(CONFLICTS_CSV)
        conf_id = f"CONF_{len(conflicts) + 1:04d}"
        sid = self.student_data.get("student_id", "Unknown")
        now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        
        conflicts.append({
            "conflict_id": conf_id,
            "student_id": sid,
            "issue_type": "Focus Loss / App Shift",
            "description": f"Window lost focus during quiz '{self.quiz_id}'. Count: {self.tab_switches}",
            "timestamp": now,
            "status": "Flagged"
        })
        write_data(CONFLICTS_CSV, conflicts, CONFLICT_FIELDS)

    def start_timer(self):
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.update_timer)
        self.timer.start(1000)
        self.update_timer_display()

    def update_timer(self):
        if self.time_left > 0:
            self.time_left -= 1
            self.update_timer_display()
        else:
            self.timer.stop()
            QMessageBox.warning(self, "Time Limit Reached", "Quiz time expired! Submitting answers automatically.")
            self.submit_quiz()

    def update_timer_display(self):
        m, s = divmod(self.time_left, 60)
        self.lbl_timer.setText(f"⏱️ {m:02d}:{s:02d}")
        if self.time_left < 60:
            self.lbl_timer.setStyleSheet("font-size: 20px; font-weight: bold; color: #ef4444; background: #151c2c; padding: 8px 18px; border-radius: 8px; border: 1px solid #ef4444;")

    def render_q(self):
        total = len(self.questions)
        if total == 0:
            return

        self.progress.setValue(int(((self.index + 1) / total) * 100))
        self.lbl_q_num.setText(f"Question {self.index + 1} of {total}")
        
        q_data = self.questions[self.index]
        self.lbl_q_txt.setText(q_data.get("question", ""))

        self.options_stack.setCurrentIndex(0)
        opts = q_data.get("options", [])
        
        self.btn_group.setExclusive(False)
        for i, r in enumerate(self.radios):
            if i < len(opts):
                r.setText(opts[i])
                r.show()
                r.setChecked(False)
            else:
                r.hide()
        self.btn_group.setExclusive(True)

        saved_ans = self.answers.get(self.index)
        if saved_ans is not None and isinstance(saved_ans, int) and saved_ans < len(opts):
            self.radios[saved_ans].setChecked(True)

        self.btn_prev.setEnabled(self.index > 0)
        self.btn_next.setEnabled(self.index < total - 1)

    def option_selected(self, btn_id):
        self.answers[self.index] = btn_id

    def prev_q(self):
        if self.index > 0:
            self.index -= 1
            self.render_q()

    def next_q(self):
        if self.index < len(self.questions) - 1:
            self.index += 1
            self.render_q()

    def confirm_submit(self):
        res = QMessageBox.question(
            self, "Confirm Submission", 
            "Are you sure you want to finish and submit your quiz?",
            QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No
        )
        if res == QMessageBox.StandardButton.Yes:
            self.submit_quiz()

    def submit_quiz(self):
        self.is_submitted = True
        if hasattr(self, "timer"):
            self.timer.stop()

        score = 0
        for i, q in enumerate(self.questions):
            user_ans = self.answers.get(i)
            correct_idx = q.get("correct_option_index", 0)
            if user_ans == correct_idx:
                score += 1

        sessions = read_data(SESSIONS_CSV)
        sess_id = f"SESS_{len(sessions) + 1:04d}"
        now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        sid = self.student_data.get("student_id", "")

        sessions.append({
            "session_id": sess_id,
            "student_id": sid,
            "quiz_id": self.quiz_id,
            "score": str(score),
            "date_taken": now,
            "tab_switches": str(self.tab_switches)
        })
        write_data(SESSIONS_CSV, sessions, SESSION_FIELDS)

        QMessageBox.information(
            self, "Submission Complete", 
            f"Quiz submitted successfully!\n\nFinal Score: {score} / {len(self.questions)}\nFocus Shifts Detected: {self.tab_switches}"
        )

        self.showNormal()
        self.close()
        if self.on_finish:
            self.on_finish()


# ==========================================
# APPLICATION CONTROLLER
# ==========================================
class ApplicationController:
    def __init__(self):
        self.login_dlg = None
        self.main_window = None

    def start(self):
        initialize_storage()
        self.show_login()

    def show_login(self):
        self.login_dlg = LoginWindow()
        if self.login_dlg.exec() == QDialog.DialogCode.Accepted:
            role = self.login_dlg.user_role
            if role == "professor":
                self.main_window = ProfessorDashboard(on_logout=self.show_login)
                self.main_window.show()
            elif role == "student":
                self.main_window = StudentDashboard(
                    student_data=self.login_dlg.student_data, 
                    on_logout=self.show_login
                )
                self.main_window.show()

def main():
    app = QApplication(sys.argv)
    controller = ApplicationController()
    controller.start()
    sys.exit(app.exec())

if __name__ == "__main__":
    main()
