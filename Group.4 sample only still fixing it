        self.load_quizzes()

    def resizeEvent(self, event):
        w = event.size().width()
        if w < 580:
            self.apply_phone_mode()
        elif 580 <= w < 880:
            self.apply_tablet_mode()
        else:
            self.apply_pc_mode()
        super().resizeEvent(event)

    def apply_phone_mode(self):
        if self.current_mode == "phone":
            return
        self.current_mode = "phone"
        self.lbl_device_badge.setText("📱 Mobile View Mode")
        self.lbl_responsive_prompt.setText(
            "<b>Mobile Prompt:</b> Tap a quiz row in the list below to select it. "
            "Scroll down to view completion statuses before launching your proctored assessment."
        )
        self.btn_start.setStyleSheet("font-size: 15px; padding: 16px; font-weight: bold;")

    def apply_tablet_mode(self):
        if self.current_mode == "tablet":
            return
        self.current_mode = "tablet"
        self.lbl_device_badge.setText("📲 Tablet View Mode")
        self.lbl_responsive_prompt.setText(
            "<b>Tablet Prompt:</b> Tap to select a quiz from the table. "
            "Ensure device orientation remains locked before entering fullscreen mode."
        )
        self.btn_start.setStyleSheet("font-size: 14px; padding: 14px;")

    def apply_pc_mode(self):
        if self.current_mode == "pc":
            return
        self.current_mode = "pc"
        self.lbl_device_badge.setText("🖥️ Desktop PC View Mode")
        self.lbl_responsive_prompt.setText(
            "<b>Desktop Prompt:</b> Select a quiz using your mouse pointer. "
            "Click <b>Launch Selected Quiz</b> to proceed to the fullscreen confirmation screen."
        )
        self.btn_start.setStyleSheet("font-size: 14px; padding: 12px;")

    def logout(self):
        self.close()
        if self.on_logout:
            self.on_logout()

    def load_quizzes(self):
        self.table.setRowCount(0)
        sessions = read_data(SESSIONS_CSV)
        sid = self.student_data.get("student_id", "")

        for q in read_data(QUIZZES_CSV):
            qid = q.get("quiz_id")
            att = [s for s in sessions if s.get("student_id") == sid and s.get("quiz_id") == qid]
            st = f"Completed ({att[-1].get('score', '0')}/{q.get('total_questions', '0')})" if att else "Available"

            r = self.table.rowCount()
            self.table.insertRow(r)
            item = table_cell(q.get("title", ""))
            item.setData(Qt.ItemDataRole.UserRole, qid)
            self.table.setItem(r, 0, item)
            self.table.setItem(r, 1, table_cell(f"{q.get('total_questions', '0')} Questions"))
            self.table.setItem(r, 2, table_cell(f"{q.get('duration_minutes', '10')} Mins"))
            
            st_item = table_cell(st)
            if "Completed" in st:
                st_item.setForeground(QColor("#10b981"))
            else:
                st_item.setForeground(QColor("#818cf8"))
            self.table.setItem(r, 3, st_item)

    def start_quiz(self):
        r = self.table.currentRow()
        if r < 0:
            QMessageBox.information(self, "Selection Required", "Please select a quiz from the table first.")
            return

        qid = self.table.item(r, 0).data(Qt.ItemDataRole.UserRole)
        qs = load_quiz_questions(qid)
        if not qs:
            QMessageBox.warning(self, "Empty Quiz", "This quiz does not contain any questions yet.")
            return

        q_list = read_data(QUIZZES_CSV)
        qz = next((q for q in q_list if q.get("quiz_id") == qid), {})
        title = qz.get("title", "Quiz")
        dur = qz.get("duration_minutes", "10")

        prompt = FullscreenPromptDialog(quiz_title=title, duration=dur, total_q=str(len(qs)), parent=self)
        if prompt.exec() == QDialog.DialogCode.Accepted:
            self.runner = QuizRunner(self.student_data, qid, on_finish=self.load_quizzes)
            self.runner.showFullScreen()


