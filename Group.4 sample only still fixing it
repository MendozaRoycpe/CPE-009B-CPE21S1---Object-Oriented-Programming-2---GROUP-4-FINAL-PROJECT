            QMessageBox.warning(self, "Empty Exam", "This exam does not contain any questions yet.")
            return

        self.runner = QuizRunner(self.student_data, qid, on_finish=self.load_quizzes)
        self.runner.show()


# ==========================================
# PROCTORED QUIZ RUNNER (ANTI-CHEAT SYSTEM)
# ==========================================
class QuizRunner(QWidget):
    def __init__(self, student_data: dict, quiz_id: str, on_finish=None, parent=None):
        super().__init__(parent)
        self.setStyleSheet(APP_STYLE)
        self.student_data = student_data
        self.quiz_id = quiz_id
        self.on_finish = on_finish
        self.questions = load_quiz_questions(quiz_id)
        self.index = 0
        self.answers = {}
        self.tab_switches = 0
        self.is_submitted = False

        q_list = read_data(QUIZZES_CSV)
        qz = next((q for q in q_list if q.get("quiz_id") == quiz_id), {})
        self.title = qz.get("title", "Exam")
        self.time_left = int(qz.get("duration_minutes", 10)) * 60

        # Scope event filter to this active window
        self.installEventFilter(self)

        self.build_ui()
        self.start_timer()
        self.render_q()

    def build_ui(self):
        self.setWindowTitle(f"Proctored Exam Session - {self.title}")
        apply_icon(self)
        self.resize(820, 580)

        layout = QVBoxLayout(self)
        layout.setSpacing(14)

        top = QHBoxLayout()
        self.lbl_title = QLabel(f"<b style='font-size:16px;'>📝 {self.title}</b>")
        self.lbl_timer = QLabel("⏱️ 00:00")
        self.lbl_timer.setStyleSheet("font-size: 18px; font-weight: bold; color: #a29bfe; background: #151821; padding: 6px 14px; border-radius: 8px; border: 1px solid #232838;")
        
        top.addWidget(self.lbl_title)
        top.addStretch()
        top.addWidget(self.lbl_timer)
        layout.addLayout(top)

        # Anti-Cheat Panel
        self.warn_card = QFrame()
        self.warn_card.setObjectName("WarningCardClean")
        wc_layout = QHBoxLayout(self.warn_card)
        wc_layout.setContentsMargins(14, 10, 14, 10)
        
        self.lbl_warning = QLabel("🛡️ Proctored Environment Active — Tab switching & focus loss are monitored.")
        self.lbl_warning.setStyleSheet("color: #00b894; font-weight: bold;")
        self.lbl_switches = QLabel("Focus Loss: 0")
        self.lbl_switches.setStyleSheet("color: #ffffff; font-weight: bold; background: #1a1e2b; padding: 4px 10px; border-radius: 6px;")
        
        wc_layout.addWidget(self.lbl_warning)
        wc_layout.addStretch()
        wc_layout.addWidget(self.lbl_switches)
        layout.addWidget(self.warn_card)

        self.progress = QProgressBar()
        layout.addWidget(self.progress)

        # Question Panel
        self.card = QFrame()
        self.card.setObjectName("Panel")
        c_layout = QVBoxLayout(self.card)
        c_layout.setContentsMargins(24, 24, 24, 24)

        self.lbl_q_num = QLabel("Question 1")
        self.lbl_q_num.setStyleSheet("color: #6c5ce7; font-weight: bold; font-size: 14px;")
        
        self.lbl_q_txt = QLabel("Question text...")
        self.lbl_q_txt.setWordWrap(True)
        self.lbl_q_txt.setStyleSheet("font-size: 16px; font-weight: 600; margin-top: 6px; margin-bottom: 12px;")

        c_layout.addWidget(self.lbl_q_num)
        c_layout.addWidget(self.lbl_q_txt)

        self.options_stack = QStackedWidget()

        # Stack Page 0: Multiple Choice / True-False Radios
        self.radio_widget = QWidget()
        rw_layout = QVBoxLayout(self.radio_widget)
        rw_layout.setContentsMargins(0, 0, 0, 0)
        
        self.btn_group = QButtonGroup(self)
        self.radios = []
        for i in range(4):
            r = QRadioButton(f"Option {i+1}")
            self.btn_group.addButton(r, i)
            self.radios.append(r)
            rw_layout.addWidget(r)
        
        self.btn_group.idClicked.connect(self.option_selected)
        self.options_stack.addWidget(self.radio_widget)

        # Stack Page 1: Identification Input
        self.ident_widget = QWidget()
        iw_layout = QVBoxLayout(self.ident_widget)
        iw_layout.setContentsMargins(0, 0, 0, 0)
        self.txt_ident = QLineEdit()
        self.txt_ident.setPlaceholderText("Type your answer here...")
        self.txt_ident.textChanged.connect(self.text_ans_changed)
        iw_layout.addWidget(self.txt_ident)
        self.options_stack.addWidget(self.ident_widget)

        c_layout.addWidget(self.options_stack)
