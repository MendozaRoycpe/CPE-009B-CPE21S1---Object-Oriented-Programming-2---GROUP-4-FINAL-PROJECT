    def load_all(self):
        self.table_quizzes.setRowCount(0)
        for q in read_data(QUIZZES_CSV):
            r = self.table_quizzes.rowCount()
            self.table_quizzes.insertRow(r)
            self.table_quizzes.setItem(r, 0, table_cell(q.get("quiz_id", "")))
            self.table_quizzes.setItem(r, 1, table_cell(q.get("title", "")))
            self.table_quizzes.setItem(r, 2, table_cell(f"{q.get('duration_minutes', '10')} Mins"))
            self.table_quizzes.setItem(r, 3, table_cell(f"{q.get('total_questions', '0')} Qs"))

        self.table_students.setRowCount(0)
        sessions = read_data(SESSIONS_CSV)
        quizzes = {q.get("quiz_id"): q.get("total_questions", "?") for q in read_data(QUIZZES_CSV)}

        for s in read_data(STUDENTS_CSV):
            sid = s.get("student_id", "")
            st_sess = [ss for ss in sessions if ss.get("student_id") == sid]
            
            summary = ", ".join([f"{ss.get('quiz_id')}: {ss.get('score')}/{quizzes.get(ss.get('quiz_id'), '?')}" for ss in st_sess]) if st_sess else "None"

            r = self.table_students.rowCount()
            self.table_students.insertRow(r)
            self.table_students.setItem(r, 0, table_cell(sid))
            self.table_students.setItem(r, 1, table_cell(s.get("first_name", "")))
            self.table_students.setItem(r, 2, table_cell(s.get("last_name", "")))
            self.table_students.setItem(r, 3, table_cell(s.get("email", "")))
            self.table_students.setItem(r, 4, table_cell(summary))

    def create_quiz(self):
        t = self.txt_title.text().strip()
        d = self.txt_dur.text().strip()
        if not t or not d or not d.isdigit():
            QMessageBox.warning(self, "Validation Error", "Title and integer duration are required.")
            return
        quizzes = read_data(QUIZZES_CSV)
        qid = f"QUIZ_{len(quizzes) + 1:03d}"
        quizzes.append({"quiz_id": qid, "title": t, "subject": "General", "total_questions": "0", "duration_minutes": d})
        write_data(QUIZZES_CSV, quizzes, QUIZ_FIELDS)
        self.txt_title.clear()
        self.txt_dur.clear()
        self.load_all()

    def manage_q(self):
        r = self.table_quizzes.currentRow()
        if r < 0:
            return
        qid = self.table_quizzes.item(r, 0).text()
        title = self.table_quizzes.item(r, 1).text()
        QuizQuestionsManager(qid, title, parent=self).exec()
        self.load_all()

    def delete_quiz(self):
        r = self.table_quizzes.currentRow()
        if r < 0:
            return
        qid = self.table_quizzes.item(r, 0).text()
        quizzes = [q for q in read_data(QUIZZES_CSV) if q.get("quiz_id") != qid]
        write_data(QUIZZES_CSV, quizzes, QUIZ_FIELDS)
        self.load_all()

    def open_gradebook(self):
        r = self.table_students.currentRow()
        sid = None
        if r >= 0:
            item = self.table_students.item(r, 0)
            if item:
                sid = item.text().strip()
        
        dlg = GradebookDialog(student_id=sid, parent=self)
        dlg.exec()


