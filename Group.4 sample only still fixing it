class QuizQuestionsManager(QDialog):
    def __init__(self, quiz_id, quiz_title, parent=None):
        super().__init__(parent)
        self.setStyleSheet(APP_STYLE)
        self.quiz_id = quiz_id
        self.quiz_title = quiz_title
        self.setWindowTitle(f"Quiz Portal - {quiz_title}")
        apply_icon(self)
        self.resize(720, 500)
        self.questions = load_quiz_questions(self.quiz_id)
        self.build_ui()

    def build_ui(self):
        layout = QVBoxLayout(self)

        self.table = QTableWidget(0, 3)
        self.table.setHorizontalHeaderLabels(["#", "Question Prompt", "Correct Answer"])
        header = self.table.horizontalHeader()
        if header is not None:
            header.setSectionResizeMode(1, QHeaderView.ResizeMode.Stretch)
        layout.addWidget(self.table)

        btns = QHBoxLayout()
        btn_add = QPushButton("+ Add Question")
        btn_add.clicked.connect(self.add_q)

        btn_edit = QPushButton("Edit")
        btn_edit.setObjectName("BtnSecondary")
        btn_edit.clicked.connect(self.edit_q)

        btn_del = QPushButton("Delete")
        btn_del.setObjectName("BtnDanger")
        btn_del.clicked.connect(self.del_q)

        btns.addWidget(btn_add)
        btns.addWidget(btn_edit)
        btns.addWidget(btn_del)
        layout.addLayout(btns)

        self.refresh()

    def refresh(self):
        self.table.setRowCount(0)
        for i, q in enumerate(self.questions):
            row = self.table.rowCount()
            self.table.insertRow(row)
            self.table.setItem(row, 0, table_cell(str(i + 1)))
            self.table.setItem(row, 1, table_cell(q.get("question", "")))
            
            c_idx = q.get("correct_option_index", 0)
            opts = q.get("options", [])
            txt = opts[c_idx] if c_idx < len(opts) else "N/A"
            self.table.setItem(row, 2, table_cell(txt))

    def add_q(self):
        dlg = QuestionEditorDialog(parent=self)
        if dlg.exec() == QDialog.DialogCode.Accepted:
            self.questions.append(dlg.question_data)
            save_quiz_questions(self.quiz_id, self.questions)
            self.sync_count()
            self.refresh()

    def edit_q(self):
        row = self.table.currentRow()
        if row < 0:
            return
        dlg = QuestionEditorDialog(question_data=self.questions[row], parent=self)
        if dlg.exec() == QDialog.DialogCode.Accepted:
            self.questions[row] = dlg.question_data
            save_quiz_questions(self.quiz_id, self.questions)
            self.refresh()

    def del_q(self):
        row = self.table.currentRow()
        if row < 0:
            return
        self.questions.pop(row)
        save_quiz_questions(self.quiz_id, self.questions)
        self.sync_count()
        self.refresh()

    def sync_count(self):
        quizzes = read_data(QUIZZES_CSV)
        for q in quizzes:
            if q.get("quiz_id") == self.quiz_id:
                q["total_questions"] = str(len(self.questions))
                break
        write_data(QUIZZES_CSV, quizzes, QUIZ_FIELDS)


