POSSIBLE_ICONS = ["icon.png", "icon.webp", "icon.jpg", "icon.ico"]

def load_app_icon():
    for name in POSSIBLE_ICONS:
        path = os.path.join(BASE_DIR, name)
        if os.path.exists(path):
            return path
    return ""

def apply_icon(widget):
    icon_path = load_app_icon()
    if icon_path:
        pix = QPixmap(icon_path)
        if not pix.isNull():
            widget.setWindowIcon(QIcon(pix))

def hash_pass(pwd: str) -> str:
    return hashlib.sha256(pwd.encode()).hexdigest()

def initialize_storage():
    os.makedirs(DATA_DIR, exist_ok=True)
    os.makedirs(QUESTIONS_DIR, exist_ok=True)

    files = [
        (STUDENTS_CSV, STUDENT_FIELDS),
        (RETIRED_CSV, ["student_id", "date_retired"]),
        (QUIZZES_CSV, QUIZ_FIELDS),
        (SESSIONS_CSV, SESSION_FIELDS),
        (CONFLICTS_CSV, CONFLICT_FIELDS)
    ]

    for path, headers in files:
        if not os.path.exists(path):
            with open(path, "w", newline="", encoding="utf-8") as f:
                csv.DictWriter(f, fieldnames=headers).writeheader()

    if not os.path.exists(AUTH_CSV):
        with open(AUTH_CSV, "w", newline="", encoding="utf-8") as f:
            writer = csv.DictWriter(f, fieldnames=["password_hash"])
            writer.writeheader()
            writer.writerow({"password_hash": hash_pass("jabaiskript")})

def read_data(path: str) -> list:
    if not os.path.exists(path):
        return []
    with open(path, "r", encoding="utf-8") as f:
        return list(csv.DictReader(f))

def write_data(path: str, rows: list, headers: list):
    with open(path, "w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=headers)
        writer.writeheader()
        writer.writerows(rows)

def load_quiz_questions(quiz_id: str) -> list:
    path = os.path.join(QUESTIONS_DIR, f"{quiz_id}.json")
    if not os.path.exists(path):
        return []
    with open(path, "r", encoding="utf-8") as f:
        return json.load(f)

def save_quiz_questions(quiz_id: str, questions: list):
    path = os.path.join(QUESTIONS_DIR, f"{quiz_id}.json")
    with open(path, "w", encoding="utf-8") as f:
        json.dump(questions, f, indent=2)

def table_cell(text: str) -> QTableWidgetItem:
    item = QTableWidgetItem(text)
    item.setFlags(Qt.ItemFlag.ItemIsSelectable | Qt.ItemFlag.ItemIsEnabled)
    return item


