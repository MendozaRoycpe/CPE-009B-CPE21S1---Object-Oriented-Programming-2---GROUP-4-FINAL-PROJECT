class QuestionEditorDialog(QDialog):
    def __init__(self, question_data=None, parent=None):
        super().__init__(parent)
        self.setStyleSheet(APP_STYLE)
        self.setWindowTitle("Question Editor")
        apply_icon(self)
        self.setFixedWidth(520)
        self.question_data = question_data or {}
        self.build_ui()

    def build_ui(self):
        layout = QVBoxLayout(self)

        layout.addWidget(QLabel("Question Format Type:"))
        self.cmb_type = QComboBox()
        self.cmb_type.addItems(["Multiple Choice", "True / False", "Identification (Text Input)"])
        self.cmb_type.currentIndexChanged.connect(self.type_changed)
        layout.addWidget(self.cmb_type)

        layout.addWidget(QLabel("Question Prompt:"))
        self.txt_q = QTextEdit()
        self.txt_q.setFixedHeight(80)
        self.txt_q.setPlainText(self.question_data.get("question", ""))
        layout.addWidget(self.txt_q)

        self.options_container = QWidget()
        self.opt_layout = QVBoxLayout(self.options_container)
        self.opt_layout.setContentsMargins(0, 0, 0, 0)

        self.option_inputs = []
        opts = self.question_data.get("options", ["", "", "", ""])

        for i in range(4):
            inp = QLineEdit()
            inp.setPlaceholderText(f"Option {i+1}")
            if i < len(opts):
                inp.setText(opts[i])
            self.option_inputs.append(inp)
            self.opt_layout.addWidget(inp)

        layout.addWidget(self.options_container)

        self.lbl_correct = QLabel("Correct Answer Selection:")
        layout.addWidget(self.lbl_correct)
        
        self.cmb_correct = QComboBox()
        layout.addWidget(self.cmb_correct)

        self.txt_ident_ans = QLineEdit()
        self.txt_ident_ans.setPlaceholderText("Type exact expected answer text...")
        self.txt_ident_ans.hide()
        layout.addWidget(self.txt_ident_ans)

        btns = QHBoxLayout()
        btn_save = QPushButton("Save Question")
        btn_save.clicked.connect(self.save)
        btn_cancel = QPushButton("Cancel")
        btn_cancel.setObjectName("BtnSecondary")
        btn_cancel.clicked.connect(self.reject)

        btns.addWidget(btn_cancel)
        btns.addWidget(btn_save)
        layout.addLayout(btns)

        q_type = self.question_data.get("type", "mc")
        if q_type == "tf":
            self.cmb_type.setCurrentIndex(1)
        elif q_type == "ident":
            self.cmb_type.setCurrentIndex(2)
        else:
            self.cmb_type.setCurrentIndex(0)

        self.type_changed()

    def type_changed(self):
        idx = self.cmb_type.currentIndex()
        if idx == 1:  # True / False
            self.options_container.show()
            self.option_inputs[0].setText("True")
            self.option_inputs[1].setText("False")
            self.option_inputs[0].setEnabled(False)
            self.option_inputs[1].setEnabled(False)
            self.option_inputs[2].hide()
            self.option_inputs[3].hide()

            self.cmb_correct.show()
            self.txt_ident_ans.hide()
            self.cmb_correct.clear()
            self.cmb_correct.addItems(["Option 1: True", "Option 2: False"])
            c_idx = self.question_data.get("correct_option_index", 0)
            if c_idx < self.cmb_correct.count():
                self.cmb_correct.setCurrentIndex(c_idx)

        elif idx == 2:  # Identification
            self.options_container.hide()
            self.cmb_correct.hide()
            self.txt_ident_ans.show()
            self.txt_ident_ans.setText(str(self.question_data.get("correct_text", "")))

        else:  # Multiple Choice
            self.options_container.show()
            self.option_inputs[0].setEnabled(True)
            self.option_inputs[1].setEnabled(True)
            self.option_inputs[2].show()
            self.option_inputs[3].show()

            self.cmb_correct.show()
            self.txt_ident_ans.hide()
            self.cmb_correct.clear()
            self.cmb_correct.addItems(["Option 1", "Option 2", "Option 3", "Option 4"])
            c_idx = self.question_data.get("correct_option_index", 0)
            if c_idx < self.cmb_correct.count():
                self.cmb_correct.setCurrentIndex(c_idx)

    def save(self):
        q_text = self.txt_q.toPlainText().strip()
        idx = self.cmb_type.currentIndex()

        if not q_text:
            QMessageBox.warning(self, "Validation Error", "Question prompt cannot be empty.")
            return

        if idx == 0:  # Multiple Choice
            opts = [i.text().strip() for i in self.option_inputs]
            if any(not o for o in opts):
                QMessageBox.warning(self, "Validation Error", "Please fill in all 4 option slots.")
                return
            self.question_data = {
                "type": "mc",
                "question": q_text,
                "options": opts,
                "correct_option_index": self.cmb_correct.currentIndex()
            }
        elif idx == 1:  # True / False
            self.question_data = {
                "type": "tf",
                "question": q_text,
                "options": ["True", "False"],
                "correct_option_index": self.cmb_correct.currentIndex()
            }
        else:  # Identification
            ans = self.txt_ident_ans.text().strip()
            if not ans:
                QMessageBox.warning(self, "Validation Error", "Target text answer cannot be blank.")
                return
            self.question_data = {
                "type": "ident",
                "question": q_text,
                "options": [],
                "correct_text": ans
            }

        self.accept()


