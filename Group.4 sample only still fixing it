        self.txt_prof_pass.setEchoMode(QLineEdit.EchoMode.Password)
        pr_layout.addWidget(self.txt_prof_pass)

        p_layout.addWidget(self.prof_box)

        self.btn_login = QPushButton("Authenticate Session")
        self.btn_login.setStyleSheet("margin-top: 10px; font-size: 14px;")
        self.btn_login.clicked.connect(self.login)
        p_layout.addWidget(self.btn_login)

