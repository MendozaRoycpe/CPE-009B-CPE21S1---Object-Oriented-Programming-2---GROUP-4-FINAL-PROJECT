class QuizWindow(QWidget):
    def __init__(self, student_id: str, quiz_id: str, parent=None):
        super().__init__(parent)
        self.setStyleSheet(QUIZZIZ_STYLE)
        self.student_id = student_id
        self.quiz_id = quiz_id
        
        self.questions = load_questions(quiz_id)
        self.current_index = 0
        self.user_answers = {}
        
        quizzes = read_csv(QUIZZES_FILE)
        quiz_data = next((q for q in quizzes if q.get("quiz_id") == quiz_id), {})
        self.quiz_title = quiz_data.get("title", "Quiz Game")
        duration_mins = int(quiz_data.get("duration_minutes", 10))
        self.time_left_seconds = duration_mins * 60

        self.init_ui()
        self.start_timer()
        self.display_question()

    def init_ui(self):
        self.setWindowTitle(f"Quizizz - {self.quiz_title}")
        self.resize(750, 520)
        
        main_layout = QVBoxLayout(self)
        main_layout.setContentsMargins(20, 20, 20, 20)
        
        header_card = QFrame()
        header_card.setObjectName("CardPanel")
        header_layout = QHBoxLayout(header_card)

        self.lbl_title = QLabel(f"<b>{self.quiz_title}</b>")
        self.lbl_title.setStyleSheet("font-size: 18px;")

        self.lbl_timer = QLabel("⏱️ --:--")
        self.lbl_timer.setStyleSheet("font-size: 18px; font-weight: bold; color: #ffd166;")

        header_layout.addWidget(self.lbl_title)
        header_layout.addStretch()
        header_layout.addWidget(self.lbl_timer)
        main_layout.addWidget(header_card)

        self.card_widget = QFrame()
        self.card_widget.setObjectName("CardPanel")
        card_layout = QVBoxLayout(self.card_widget)
        
        self.lbl_q_number = QLabel("Question 1")
        self.lbl_q_number.setStyleSheet("font-size: 14px; font-weight: bold; color: #8854c0;")
        
        self.lbl_q_text = QLabel("Question text goes here...")
        self.lbl_q_text.setWordWrap(True)
        self.lbl_q_text.setStyleSheet("font-size: 18px; font-weight: bold; margin: 10px 0;")
        
        card_layout.addWidget(self.lbl_q_number)
        card_layout.addWidget(self.lbl_q_text)

        self.options_group = QButtonGroup(self)
        self.option_radios = []
        
        for i in range(4):
            radio = QRadioButton(f"Option {i+1}")
            radio.setObjectName(f"Opt{i}")
            self.options_group.addButton(radio, i)
            self.option_radios.append(radio)
            card_layout.addWidget(radio)

        main_layout.addWidget(self.card_widget)

        nav_layout = QHBoxLayout()
        self.btn_prev = QPushButton("◀ Previous")
        self.btn_prev.setObjectName("BtnSecondary")
        self.btn_prev.clicked.connect(self.prev_question)
        
        self.btn_next = QPushButton("Next ▶")
        self.btn_next.clicked.connect(self.next_question)
        
        self.btn_submit = QPushButton("🚀 Submit Quiz")
        self.btn_submit.setStyleSheet("background-color: #06d6a0; color: #0d0814;")
        self.btn_submit.clicked.connect(self.confirm_submit)

        nav_layout.addWidget(self.btn_prev)
        nav_layout.addWidget(self.btn_next)
        nav_layout.addStretch()
        nav_layout.addWidget(self.btn_submit)
        
        main_layout.addLayout(nav_layout)

    def start_timer(self):
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.update_timer)
        self.timer.start(1000)
        self.update_timer()

    def update_timer(self):
        if self.time_left_seconds <= 0:
            self.timer.stop()
            QMessageBox.warning(self, "Time Expired", "Time is up! Answers submitted automatically.")
            self.submit_quiz()
            return

        mins, secs = divmod(self.time_left_seconds, 60)
        self.lbl_timer.setText(f"⏱️ {mins:02d}:{secs:02d}")
        self.time_left_seconds -= 1

    def display_question(self):
        if not self.questions:
            self.lbl_q_text.setText("No questions available for this quiz.")
            return

        q_data = self.questions[self.current_index]
        self.lbl_q_number.setText(f"QUESTION {self.current_index + 1} OF {len(self.questions)}")
        self.lbl_q_text.setText(q_data.get("question", ""))

        self.options_group.setExclusive(False)
        for r in self.option_radios:
            r.setChecked(False)
        self.options_group.setExclusive(True)

        options = q_data.get("options", [])
        for i, option_text in enumerate(options):
            if i < len(self.option_radios):
                self.option_radios[i].setText(option_text)
                self.option_radios[i].setVisible(True)

        for i in range(len(options), len(self.option_radios)):
            self.option_radios[i].setVisible(False)

        if self.current_index in self.user_answers:
            selected_idx = self.user_answers[self.current_index]
            if 0 <= selected_idx < len(options):
                self.option_radios[selected_idx].setChecked(True)

        self.btn_prev.setEnabled(self.current_index > 0)
        self.btn_next.setEnabled(self.current_index < len(self.questions) - 1)

        apply_fade_in(self.card_widget)

    def save_current_answer(self):
        selected_id = self.options_group.checkedId()
        if selected_id != -1:
            self.user_answers[self.current_index] = selected_id

    def prev_question(self):
        self.save_current_answer()
        if self.current_index > 0:
            self.current_index -= 1
            self.display_question()

    def next_question(self):
        self.save_current_answer()
        if self.current_index < len(self.questions) - 1:
            self.current_index += 1
            self.display_question()

    def confirm_submit(self):
        self.save_current_answer()
        unanswered = len(self.questions) - len(self.user_answers)
        msg = "Ready to submit your quiz?"
        if unanswered > 0:
            msg = f"You have {unanswered} unanswered question(s). " + msg

        reply = QMessageBox.question(self, "Submit Quiz", msg,
                                     QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No)
        if reply == QMessageBox.StandardButton.Yes:
            self.submit_quiz()

    def submit_quiz(self):
        self.timer.stop()
        self.save_current_answer()

        score = sum(1 for idx, q in enumerate(self.questions) if self.user_answers.get(idx) == q.get("correct_option_index"))
        total = len(self.questions)
        percentage = (score / total * 100) if total > 0 else 0.0

        sessions = read_csv(SESSIONS_FILE)
        new_session = {
            "session_id": f"SESS_{len(sessions) + 1:04d}",
            "student_id": self.student_id,
            "quiz_id": self.quiz_id,
            "score": f"{score}/{total}",
            "date_taken": ""
        }
        sessions.append(new_session)
        write_csv(SESSIONS_FILE, sessions, SESSION_FIELDS)

        QMessageBox.information(self, "Quiz Finished 🎉", f"Final Score: {score} / {total} ({percentage:.1f}%)")
        self.close()

class StudentDashboard(QWidget):
    def __init__(self, student_id: str, on_logout_callback=None, parent=None):
        super().__init__(parent)
        self.setStyleSheet(QUIZZIZ_STYLE)
        self.student_id = student_id
        self.on_logout_callback = on_logout_callback
        self.quiz_window_ref = None

        self.setWindowTitle(f"Student Portal - {self.student_id}")
        self.resize(600, 420)
        self.init_ui()
        self.load_quizzes()

    def init_ui(self):
        layout = QVBoxLayout(self)
        layout.setContentsMargins(20, 20, 20, 20)

        header_layout = QHBoxLayout()
        header = QLabel(f"<h1>🎮 Welcome, {self.student_id}!</h1>")
        
        btn_logout = QPushButton("🚪 Logout")
        btn_logout.setObjectName("BtnDanger")
        btn_logout.clicked.connect(self.logout)

        header_layout.addWidget(header)
        header_layout.addStretch()
        header_layout.addWidget(btn_logout)

        layout.addLayout(header_layout)

        card = QFrame()
        card.setObjectName("CardPanel")
        card_layout = QVBoxLayout(card)

        card_layout.addWidget(QLabel("<b>Available Quizzes:</b>"))
        self.list_quizzes = QListWidget()
        card_layout.addWidget(self.list_quizzes)

        layout.addWidget(card)

        btn_layout = QHBoxLayout()
        self.btn_refresh = QPushButton("Refresh")
        self.btn_refresh.setObjectName("BtnSecondary")
        self.btn_refresh.clicked.connect(self.load_quizzes)

        self.btn_start = QPushButton("🚀 Join Quiz")
        self.btn_start.clicked.connect(self.start_quiz)

        btn_layout.addWidget(self.btn_refresh)
        btn_layout.addStretch()
        btn_layout.addWidget(self.btn_start)
        
        layout.addLayout(btn_layout)
        apply_fade_in(self)

    def logout(self):
        reply = QMessageBox.question(self, "Logout", "Are you sure you want to log out?",
                                     QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No)
        if reply == QMessageBox.StandardButton.Yes:
            self.close()
            if self.on_logout_callback:
                self.on_logout_callback()

    def load_quizzes(self):
        self.list_quizzes.clear()
        quizzes = read_csv(QUIZZES_FILE)
        
        for q in quizzes:
            title = q.get("title", "Untitled")
            quiz_id = q.get("quiz_id", "")
            duration = q.get("duration_minutes", "10")
            count = q.get("total_questions", "0")
            
            item = QListWidgetItem(f"⚡ {title}  •  {count} Questions  •  ⏱️ {duration} mins")
            item.setData(100, quiz_id)
            self.list_quizzes.addItem(item)

    def start_quiz(self):
        selected = self.list_quizzes.currentItem()
        if not selected:
            QMessageBox.warning(self, "Selection Required", "Please choose a quiz from the list.")
            return

        quiz_id = selected.data(100)
        self.quiz_window_ref = QuizWindow(student_id=self.student_id, quiz_id=quiz_id)
        self.quiz_window_ref.show()

# ==========================================
# MAIN ROUTER & ENTRY POINT
# ==========================================
def run_app():
    login = LoginDialog()
    if login.exec() == QDialog.DialogCode.Accepted:
        if login.user_role == "student" and login.student_id is not None:
            window = StudentDashboard(student_id=login.student_id, on_logout_callback=run_app)
            window.show()
            QApplication.instance()._active_window = window
        elif login.user_role == "professor":
            window = ProfessorDashboard(on_logout_callback=run_app)
            window.show()
            QApplication.instance()._active_window = window

def main():
    ensure_files()
    app = QApplication(sys.argv)
    run_app()
    sys.exit(app.exec())

if __name__ == "__main__":
    main()
