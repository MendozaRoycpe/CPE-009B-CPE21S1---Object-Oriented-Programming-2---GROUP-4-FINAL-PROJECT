class LoginDialog(QDialog):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setStyleSheet(QUIZZIZ_STYLE)
        self.setWindowTitle("Quiz System - Authentication")
        self.setFixedSize(380, 260)
        
        self.user_role = None     # "professor" or "student"
        self.student_id = None    # Set if student logs in
        
        self.init_ui()

    def init_ui(self):
        layout = QVBoxLayout(self)
        layout.setSpacing(12)

        title = QLabel("⚡ Quizizz Portal")
        title.setAlignment(Qt.AlignmentFlag.AlignCenter)
        title.setStyleSheet("font-size: 20px; font-weight: bold; color: #8854c0;")
        layout.addWidget(title)

        role_layout = QHBoxLayout()
        self.btn_mode_student = QPushButton("Student Login")
        self.btn_mode_professor = QPushButton("Professor Login")
        
        self.btn_mode_student.setCheckable(True)
        self.btn_mode_professor.setCheckable(True)
        self.btn_mode_student.setChecked(True)

        self.btn_mode_student.clicked.connect(self.set_student_mode)
        self.btn_mode_professor.clicked.connect(self.set_professor_mode)

        role_layout.addWidget(self.btn_mode_student)
        role_layout.addWidget(self.btn_mode_professor)
        layout.addLayout(role_layout)

        self.lbl_input = QLabel("Student ID:")
        self.txt_input = QLineEdit()
        self.txt_input.setPlaceholderText("Enter Student ID (e.g., STU001)")
        
        layout.addWidget(self.lbl_input)
        layout.addWidget(self.txt_input)

        self.btn_login = QPushButton("Login")
        self.btn_login.clicked.connect(self.handle_login)
        layout.addWidget(self.btn_login)

        self.set_student_mode()

    def set_student_mode(self):
        self.btn_mode_student.setChecked(True)
        self.btn_mode_professor.setChecked(False)
        self.lbl_input.setText("Student ID:")
        self.txt_input.setEchoMode(QLineEdit.EchoMode.Normal)
        self.txt_input.setPlaceholderText("Enter Student ID (e.g., STU001)")
        self.txt_input.clear()

    def set_professor_mode(self):
        self.btn_mode_professor.setChecked(True)
        self.btn_mode_student.setChecked(False)
        self.lbl_input.setText("Professor Password:")
        self.txt_input.setEchoMode(QLineEdit.EchoMode.Password)
        self.txt_input.setPlaceholderText("Enter Professor Password")
        self.txt_input.clear()

    def handle_login(self):
        val = self.txt_input.text().strip()
        if not val:
            QMessageBox.warning(self, "Input Error", "Field cannot be empty.")
            return

        if self.btn_mode_student.isChecked():
            students = read_csv(STUDENTS_FILE)
            student = next((s for s in students if s.get("student_id") == val), None)
            
            # Auto-register if student ID does not exist yet
            if not student:
                new_student = {
                    "student_id": val,
                    "first_name": "Student",
                    "last_name": val,
                    "email": f"{val.lower()}@school.edu",
                    "status": "Active"
                }
                students.append(new_student)
                write_csv(STUDENTS_FILE, students, DEFAULT_STUDENT_FIELDS)
                QMessageBox.information(self, "Account Created", f"New Student ID auto-registered: {val}")

            self.user_role = "student"
            self.student_id = val
            self.accept()
        else:
            auth_rows = read_csv(AUTH_FILE)
            input_hash = hash_password(val)
            
            match = any(row.get("password_hash") == input_hash for row in auth_rows)

            if match or val == "jabaiskript":
                self.user_role = "professor"
                self.accept()
            else:
                QMessageBox.critical(self, "Access Denied", "Invalid Password.")

